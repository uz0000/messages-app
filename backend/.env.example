# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db-name>

# Clerk (https://dashboard.clerk.com) — API Keys page
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ImageKit (https://imagekit.io) — used for image/video attachment uploads
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend origin, used for CORS and the keep-alive cron ping
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# Clerk webhook signing secret — from the endpoint configured for
# /api/webhooks/clerk in the Clerk dashboard (user.created/updated/deleted)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
